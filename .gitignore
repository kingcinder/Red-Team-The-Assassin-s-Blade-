# ═══════════════════════════════════════════════════════════════
# RedTeam Harness — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Runtime directories (generated during engagements) ──
sessions/
output/
tasks/

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/
.venv/
venv/
env/

# ── Offline wheels cache (large, regenerate with pip download) ──
wheels/

# ── Bundle integrity manifest (generated at bundle time per RELEASING.md §4;
#    committed copies can never verify — wheels/ is gitignored and source
#    hashes drift on every commit) ──
SHA256SUMS
SHA256SUMS.asc

# ── Logs ──
*.log
logs/

# ── OS junk ──
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ── IDE / Editor ──
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# ── Secrets & credentials (NEVER commit these) ──
*.pem
*.key
*.crt
*.p12
*.pfx
.htpasswd
.env
.env.*
# Allow .env.example to be tracked
!.env.example
credentials.json
service-account*.json

# ── Metasploit artifacts ──
output/msf_scripts/
*.rc

# ── Nmap output (engagement-specific) ──
*.gnmap
*.nmap
*.xml.bak

# ── Workflow task state (engagement-specific) ──
tasks/**/state.json
tasks/**/workflow.log

# ── Session data (engagement-specific) ──
sessions/*.json

# ── Report output ──
*.md.bak
reports/

# ── Temporary files ──
tmp/
temp/
*.tmp
*.bak
*.orig
