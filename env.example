# ═══════════════════════════════════════════════════════════════
# RedTeam Harness — Environment Variables
# Copy to .env and customize for your deployment
# ═══════════════════════════════════════════════════════════════

# LLM Backend
REDTEAM_LLM_BACKEND=llama-server
REDTEAM_LLM_HOST=127.0.0.1
REDTEAM_LLM_PORT=8080
REDTEAM_LLM_MODEL=carnice-qwen3.6-moe-35b

# Dashboard
REDTEAM_DASHBOARD_HOST=0.0.0.0
REDTEAM_DASHBOARD_PORT=9999
REDTEAM_DASHBOARD_DEBUG=false

# Safety
REDTEAM_SAFETY_LOG_ALL=true
REDTEAM_SAFETY_REQUIRE_CONFIRM=true

# Paths
REDTEAM_SESSION_DIR=./sessions
REDTEAM_OUTPUT_DIR=./output
REDTEAM_WORKFLOW_TASKS_DIR=./tasks
